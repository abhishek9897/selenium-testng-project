<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    parallel="classes" : each test class runs in its own thread, at the same time.
    thread-count="3"   : at most 3 threads (so at most 3 Chrome windows) at once.
    Methods inside one class still run one after another, in the same thread.
-->
<suite name="SauceDemo Test Suite" parallel="classes" thread-count="3">

    <listeners>
        <!-- Logs test events and takes a screenshot when a test fails -->
        <listener class-name="listeners.TestListener"/>
        <!-- Adds RetryAnalyzer to every test (an IAnnotationTransformer must be registered here, not with @Listeners) -->
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>

    <test name="SauceDemo UI Tests">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.ProductsTest"/>
            <class name="tests.CartTest"/>
        </classes>
    </test>
</suite>
